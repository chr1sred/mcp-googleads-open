# ============================================================================
# mcp-googleads-open — variáveis de ambiente / environment variables
# Copie para .env (docker compose) ou cadastre em "App Configs" no CapRover.
# NUNCA faça commit do arquivo .env real.
# ============================================================================

# --- Obrigatórias / Required -------------------------------------------------

# ID do projeto no Google Cloud com a Google Ads API ativada e nível de acesso aprovado
GOOGLE_PROJECT_ID=seu-projeto-gcp

# Cliente OAuth 2.0 do tipo "Aplicativo da Web" (Google Cloud > APIs e serviços > Credenciais)
GOOGLE_ADS_MCP_OAUTH_CLIENT_ID=0000000000-xxxxxxxx.apps.googleusercontent.com
GOOGLE_ADS_MCP_OAUTH_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxx

# URL pública do servidor, SEM barra no final e SEM /mcp
# O redirect URI no Google Cloud deve ser: <BASE_URL>/auth/callback
GOOGLE_ADS_MCP_BASE_URL=https://google-ads-mcp.seudominio.com

# Gere com: python3 scripts/gen-secrets.py
GOOGLE_ADS_MCP_JWT_SIGNING_KEY=
GOOGLE_ADS_MCP_STORAGE_ENCRYPTION_KEY=

# --- Opcionais / Optional ----------------------------------------------------

# ID da conta MCC (somente números, sem hífens). Também pode ser passado por chamada.
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# Developer token: descontinuado em 09/2026; deixe vazio, a menos que seu setup exija.
GOOGLE_ADS_DEVELOPER_TOKEN=

# Já definidos na imagem (só altere se souber o que está fazendo)
# PORT=8080
# GOOGLE_ADS_MCP_STORAGE_TYPE=filetree
# GOOGLE_ADS_MCP_STORAGE_PATH=/data/oauth
# GOOGLE_ADS_MCP_TOOLS_CONFIG=/data/tools_config.yaml
